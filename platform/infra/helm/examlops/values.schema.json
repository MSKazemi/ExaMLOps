{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExaMLOps Helm chart values",
  "description": "Validated by helm on install, upgrade, lint and template. Objects the chart owns reject unknown keys, so a misspelt value fails the install instead of being silently ignored.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "workloadCaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "scopes"],
      "properties": {
        "principal": {"$ref": "#/definitions/nonEmptyString"},
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["read", "write", "retrain", "approve", "changes", "admin"]}
        }
      }
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "replicas": {"type": "integer", "minimum": 0},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"$ref": "#/definitions/nonEmptyString"},
        "tag": {"type": "string", "description": "Empty = the chart's appVersion (the release these images were published with)."},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
        "limits": {"type": "object", "additionalProperties": {"type": ["string", "number"]}}
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "envVarList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"$ref": "#/definitions/nonEmptyString"}}
      }
    },
    "labelSelector": {
      "type": "object",
      "properties": {
        "matchLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "matchExpressions": {"type": "array"}
      }
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string",
          "description": "Registry prefix WITH a trailing slash, e.g. ghcr.io/mskazemi/ — required at render time.",
          "pattern": "^$|/$"
        },
        "imagePullSecrets": {"type": "array"},
        "cluster": {"type": "string"},
        "tenant": {"type": "string"}
      }
    },
    "existingSecret": {"$ref": "#/definitions/nonEmptyString"},
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string"},
        "readHost": {"type": "string"},
        "database": {"type": "string"}
      }
    },
    "minio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string"},
        "bucket": {"type": "string"}
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"features": {"type": "string"}}
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "backoffLimit": {"type": "integer", "minimum": 0},
            "activeDeadlineSeconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"}
          }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"},
        "replicaCount": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "port": {"$ref": "#/definitions/port"},
        "resources": {"$ref": "#/definitions/resources"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "extraEnv": {"$ref": "#/definitions/envVarList"}
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"},
        "replicaCount": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "port": {"$ref": "#/definitions/port"},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "cliState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"existingClaim": {"type": "string"}}
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "replicaCount": {"$ref": "#/definitions/replicas"},
        "image": {"$ref": "#/definitions/image"},
        "port": {"$ref": "#/definitions/port"},
        "serviceUrls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mlflow": {"type": "string"},
            "rayServe": {"type": "string"},
            "prometheus": {"type": "string"}
          }
        },
        "extraEnv": {"$ref": "#/definitions/envVarList"},
        "resources": {"$ref": "#/definitions/resources"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"},
        "pdb": {"$ref": "#/definitions/pdb"}
      }
    },
    "events": {
      "description": "Event backbone (ADR 0124). Followers need publisher nats and a natsUrl.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": {"enum": ["log", "nats"]},
        "natsUrl": {"type": "string", "pattern": "^$|^(nats|tls)://"},
        "followers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autopilot": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "mlflowTrackingUri": {"$ref": "#/definitions/nonEmptyString"},
                "resources": {"$ref": "#/definitions/resources"}
              }
            },
            "skipperWatch": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "resources": {"$ref": "#/definitions/resources"}
              }
            }
          }
        }
      }
    },
    "gateway": {
      "description": "The serving gateway (ADR 0126): Envoy + the authorization service.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"$ref": "#/definitions/replicas"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"$ref": "#/definitions/nonEmptyString"},
            "tag": {"$ref": "#/definitions/nonEmptyString"},
            "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {"$ref": "#/definitions/nonEmptyString"},
            "port": {"$ref": "#/definitions/port"},
            "grpcPort": {"$ref": "#/definitions/port"}
          }
        },
        "tenantRpm": {"type": "integer", "minimum": 1},
        "keyCacheSeconds": {"type": "integer", "minimum": 0},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"host": {"type": "string"}}
        },
        "authz": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicaCount": {"$ref": "#/definitions/replicas"},
            "resources": {"$ref": "#/definitions/resources"}
          }
        }
      }
    },
    "secrets": {
      "description": "The secrets manager (ADR 0011): an optional in-cluster OpenBao.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openbao": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {"$ref": "#/definitions/nonEmptyString"},
                "tag": {"$ref": "#/definitions/nonEmptyString"},
                "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
                "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
              }
            },
            "strict": {"type": "boolean"},
            "tokenSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {"$ref": "#/definitions/nonEmptyString"},
                "key": {"$ref": "#/definitions/nonEmptyString"}
              }
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {"$ref": "#/definitions/nonEmptyString"},
                "storageClassName": {"type": "string"}
              }
            },
            "resources": {"$ref": "#/definitions/resources"}
          }
        }
      }
    },
    "workloadIdentity": {
      "description": "SPIFFE workload identities from the cluster's SPIRE (ADR 0125).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "trustDomain": {"type": "string", "pattern": "^$|^[a-z0-9._-]+$"},
        "csiDriver": {"$ref": "#/definitions/nonEmptyString"},
        "socketPath": {"type": "string", "pattern": "^/"},
        "jwtTtl": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
        "clusterSPIFFEID": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"create": {"type": "boolean"}, "className": {"type": "string"}}
        },
        "helper": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {"$ref": "#/definitions/nonEmptyString"},
                "tag": {"$ref": "#/definitions/nonEmptyString"},
                "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
                "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
              }
            },
            "resources": {"$ref": "#/definitions/resources"}
          }
        },
        "callers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dashboard": {"$ref": "#/definitions/workloadCaller"},
            "agent": {"$ref": "#/definitions/workloadCaller"},
            "autopilot-follower": {"$ref": "#/definitions/workloadCaller"}
          }
        }
      }
    },
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "topologySpreadConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSkew": {"type": "integer", "minimum": 1},
        "topologyKey": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressController": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"namespaceSelector": {"$ref": "#/definitions/labelSelector"}}
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"namespaceSelector": {"$ref": "#/definitions/labelSelector"}}
        },
        "egressPorts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controlPlane": {"type": "array", "items": {"$ref": "#/definitions/port"}},
            "dashboard": {"type": "array", "items": {"$ref": "#/definitions/port"}},
            "agent": {"type": "array", "items": {"$ref": "#/definitions/port"}},
            "autopilotFollower": {"type": "array", "items": {"$ref": "#/definitions/port"}},
            "skipperWatch": {"type": "array", "items": {"$ref": "#/definitions/port"}},
            "gateway": {"type": "array", "items": {"$ref": "#/definitions/port"}},
            "gatewayAuthz": {"type": "array", "items": {"$ref": "#/definitions/port"}}
          }
        },
        "extraEgress": {"type": "array"}
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string", "pattern": "^$|^https?://", "description": "OTLP collector endpoint; empty = export disabled (OTEL_SDK_DISABLED=true)."}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}},
            "extraGroups": {"type": "array", "items": {"type": "string", "pattern": "^examlops-[a-z-]+$"}}
          }
        }
      }
    }
  }
}
