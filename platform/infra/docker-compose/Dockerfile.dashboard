# ── Stage 1: build the React frontend ────────────────────────────────────────
# Node 24 = current LTS; Vite 7 / rolldown require >=20.19 (or >=22.12).
FROM node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81 AS frontend-builder
WORKDIR /app/frontend
COPY platform/services/dashboard/frontend/package*.json ./
RUN npm install --include=dev
COPY platform/services/dashboard/frontend/ ./
RUN ./node_modules/.bin/tsc -b && ./node_modules/.bin/vite build

# ── Stage 2: Python runtime with built frontend ───────────────────────────────
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
WORKDIR /app

COPY platform/services/dashboard/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY platform/services/dashboard/backend/ ./backend/
COPY tools/ /app/tools/
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Docs served by the /documents router (routers/docs.py). Bake README.md + the whole docs/
# tree + the mkdocs nav into the image so the Documents page works in ANY deployment topology
# (compose sets EXAMLOPS_DOCS_ROOT=/repo and takes precedence when the repo is bind-mounted;
# this baked copy is the fallback for K8s/PVC where /repo does not exist). /app has README.md +
# docs/, so the router's walk-up auto-detection resolves /app even with no env var set.
COPY README.md ./
COPY mkdocs.yml ./
COPY docs/ ./docs/

# Non-root. The default uid 10001 is the chart's podSecurityContext.runAsUser; a development
# compose that bind-mounts the host checkout and state builds with APP_UID/APP_GID = the host user.
# /var/lib/examlops-dashboard is where the chart mounts the CLI Console's state; it must be the app
# user's when an empty volume is mounted over it.
ARG APP_UID=10001
ARG APP_GID=10001
RUN groupadd --gid "${APP_GID}" examlops \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --home-dir /var/lib/examlops \
       --shell /usr/sbin/nologin examlops \
    && mkdir -p /var/lib/examlops-dashboard \
    && chown -R "${APP_UID}:${APP_GID}" /app /var/lib/examlops-dashboard
USER ${APP_UID}:${APP_GID}

WORKDIR /app/backend
EXPOSE 8099
CMD ["sh", "-c", "alembic upgrade head && opentelemetry-instrument uvicorn main:app --host 0.0.0.0 --port ${DASHBOARD_PORT:-8099}"]
