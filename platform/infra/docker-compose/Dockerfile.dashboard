# ── Stage 1: build the React frontend ────────────────────────────────────────
# Node 24 = current LTS; Vite 7 / rolldown require >=20.19 (or >=22.12).
FROM node:24-alpine AS frontend-builder
WORKDIR /app/frontend
COPY platform/services/dashboard/frontend/package*.json ./
RUN npm install --include=dev
COPY platform/services/dashboard/frontend/ ./
RUN ./node_modules/.bin/tsc -b && ./node_modules/.bin/vite build

# ── Stage 2: Python runtime with built frontend ───────────────────────────────
FROM python:3.12-slim
WORKDIR /app

COPY platform/services/dashboard/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY platform/services/dashboard/backend/ ./backend/
COPY tools/ /app/tools/
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Docs served by the /documents router (routers/docs.py). Bake README.md + the whole docs/
# tree + the mkdocs nav into the image so the Documents page works in ANY deployment topology
# (compose sets EXAMLOPS_DOCS_ROOT=/repo and takes precedence when the repo is bind-mounted;
# this baked copy is the fallback for K8s/PVC where /repo does not exist). /app has README.md +
# docs/, so the router's walk-up auto-detection resolves /app even with no env var set.
COPY README.md ./
COPY mkdocs.yml ./
COPY docs/ ./docs/

WORKDIR /app/backend
EXPOSE 8099
CMD ["sh", "-c", "alembic upgrade head && opentelemetry-instrument uvicorn main:app --host 0.0.0.0 --port ${DASHBOARD_PORT:-8099}"]
