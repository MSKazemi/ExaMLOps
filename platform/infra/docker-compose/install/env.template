# ExaMLOps install bundle — environment.
#
# Do not copy this file by hand: `./install.sh init` writes .env from it, replacing every
# __GENERATE__ placeholder with a fresh random value and __EXAMLOPS_VERSION__ with the release
# this bundle belongs to. docker compose refuses to start while a required value is missing.
# Keep .env out of version control; it holds every credential of the install.

# ── Release ───────────────────────────────────────────────────────────────────
EXAMLOPS_VERSION=__EXAMLOPS_VERSION__
# Mirror the images into a registry you control (air-gapped sites) and point this at it.
EXAMLOPS_REGISTRY=ghcr.io/mskazemi
EXAMLOPS_PROJECT_NAME=examlops

# ── Optional profiles ─────────────────────────────────────────────────────────
# Comma-separated: `minio` (the bundled object store, see below) and `monitoring` (Prometheus,
# Alertmanager, Grafana, Loki, Tempo). Example: COMPOSE_PROFILES=minio,monitoring
COMPOSE_PROFILES=minio

# ── Object store ──────────────────────────────────────────────────────────────
# Bundled MinIO (evaluation and small sites; its image receives no security fixes any more):
# keep `minio` in COMPOSE_PROFILES. Your own S3 service (Ceph RGW, a cloud bucket, an
# institutional store): remove `minio` from COMPOSE_PROFILES, set the endpoint, region and keys
# of an account that may create and write the buckets below, and a read-only key for serving.
EXAMLOPS_S3_ENDPOINT=http://minio:9000
EXAMLOPS_S3_REGION=us-east-1
EXAMLOPS_S3_ACCESS_KEY=__GENERATE_USER__
EXAMLOPS_S3_SECRET_KEY=__GENERATE__
# Read-only on the artifact bucket; Ray Serve only ever downloads models. The bundled MinIO
# creates it; with your own store, issue it there.
EXAMLOPS_S3_SERVING_ACCESS_KEY=__GENERATE_USER__
EXAMLOPS_S3_SERVING_SECRET_KEY=__GENERATE__
# Bucket names are global on most public clouds; prefix them with your site there.
EXAMLOPS_S3_ARTIFACT_BUCKET=mlflow-artifacts
EXAMLOPS_PROJECTS_BUCKET=examlops-projects
DASHBOARD_MINIO_BUCKET=dashboard-model-docs

# ── Network ───────────────────────────────────────────────────────────────────
# Loopback by default. Set 0.0.0.0 only behind a firewall or a TLS-terminating reverse proxy:
# every service below speaks plain HTTP.
EXAMLOPS_BIND=127.0.0.1
# Hostname users type in their browser; used for the dashboard's links and MLflow's CORS.
PUBLIC_HOST=localhost
# Host header allow-list of the control plane (comma-separated; add PUBLIC_HOST when exposed).
CONTROL_PLANE_ALLOWED_HOSTS=localhost,127.0.0.1,control-plane
EXAMLOPS_PORT_DASHBOARD=18099
EXAMLOPS_PORT_MLFLOW=15000
EXAMLOPS_PORT_PREFECT=14200
EXAMLOPS_PORT_RAY_SERVE=18001
EXAMLOPS_PORT_RAY_DASHBOARD=18265
EXAMLOPS_PORT_CONTROL_PLANE=18002
EXAMLOPS_PORT_AGENT=18004
EXAMLOPS_PORT_MINIO=19000
EXAMLOPS_PORT_MINIO_CONSOLE=19001
EXAMLOPS_PORT_PROMETHEUS=19090
EXAMLOPS_PORT_ALERTMANAGER=19093
EXAMLOPS_PORT_GRAFANA=13000
EXAMLOPS_PORT_LOKI=13100
EXAMLOPS_PORT_TEMPO=13200

# ── Instance data (ADR 0128) ──────────────────────────────────────────────────
# Host directory mounted at /state in every service: platform.db, site.toml, usecase/, config/.
# Back it up together with the postgres_data and minio_data volumes.
EXAMLOPS_STATE_DIR=./state
# Owner of the state dir (recorded by install.sh init). Services that do not run as root join
# this group to write platform.db.
EXAMLOPS_STATE_UID=__HOST_UID__
EXAMLOPS_STATE_GID=__HOST_GID__
# Seed /state/usecase on first start with a pack shipped inside the control-plane image, e.g.
# /app/usecases/seanergy. Empty = start with no models and add your own pack to ./state/usecase.
EXAMLOPS_SEED_PACK=

# ── Credentials (generated) ───────────────────────────────────────────────────
POSTGRES_PASSWORD=__GENERATE__
CONTROL_PLANE_TOKEN=__GENERATE__
RAY_SERVE_ADMIN_TOKEN=__GENERATE__
DASHBOARD_VIEWER_PASSWORD=__GENERATE__
DASHBOARD_ADMIN_PASSWORD=__GENERATE__
DASHBOARD_JWT_SECRET=__GENERATE__
# Fernet key (url-safe base64 of 32 bytes) encrypting dashboard secrets at rest.
DASHBOARD_SECRET_KEY=__GENERATE_FERNET__
AGENT_API_KEY=__GENERATE__
# Grafana `admin` password (monitoring profile).
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# ── Optional ──────────────────────────────────────────────────────────────────
# MLflow tracking server: worker processes and memory limit (3.16 needs ~1.8 GiB with 2 workers,
# ~2.1 GiB with 4); raise both together on a busy site.
MLFLOW_WORKERS=2
MLFLOW_MEM_LIMIT=4g
# Skipper agent LLM: an Ollama server reachable from the containers.
AGENT_MODEL=llama3.1:8b
AGENT_CONTAINER_OLLAMA_URL=http://host.docker.internal:11434
# Platform datastore engine: sqlite (./state/platform.db) or postgres (set the DSN too).
EXAMLOPS_DB_BACKEND=sqlite
EXAMLOPS_POSTGRES_DSN=
# Verify-before-load for served models: off | warn | enforce.
EXAMLOPS_SERVING_VERIFY=off
EXAMLOPS_SIGNING_KEY=
EXAMLOPS_SLURM_MODE=mock
# Tracing: with the monitoring profile, set OTEL_SDK_DISABLED=false and
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317 to send traces to Tempo.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
# Backup profile.
EXAMLOPS_BACKUP_INTERVAL=3600
EXAMLOPS_BACKUP_RETAIN=keep=14
EXAMLOPS_BACKUP_S3_URI=
