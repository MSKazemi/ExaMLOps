{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "annotations": {
    "list": [
      {
        "datasource": {"type": "loki", "uid": "loki"},
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Approvals",
        "target": {
          "expr": "{project=\"examlops\",compose_service=\"control-plane\"} |~ \"(?i)(approved|rejected|expired)\"",
          "maxLines": 100,
          "refId": "approval-events"
        },
        "type": "logs"
      }
    ]
  },
  "description": "ExaMLOps Approval Gate — pending queue, approval funnel, SLA tracking, event history",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Overview",       "url": "/d/examlops-overview",      "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""},
    {"title": "Control Plane",  "url": "/d/examlops-control-plane", "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""}
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Approval Queue Status",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pending Approvals",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "examlops_approvals_pending", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest Pending (hours)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "examlops_approval_age_oldest_seconds / 3600", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 8}]}
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Approvals Created (24 h)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(examlops_approval_events_total{action=\"created\"}[24h]) or vector(0)", "legendFormat": "{{model_id}}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Approvals Approved (24 h)",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(examlops_approval_events_total{action=\"approved\"}[24h]) or vector(0)", "legendFormat": "{{model_id}}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Approvals Rejected (24 h)",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(examlops_approval_events_total{action=\"rejected\"}[24h]) or vector(0)", "legendFormat": "{{model_id}}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Approvals Expired (24 h)",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(examlops_approvals_expired_total[24h]) or vector(0)", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Approval Funnel & SLA",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Approval Rate (24 h)",
      "description": "approved / (approved + rejected)",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "clamp_max(sum(increase(examlops_approval_events_total{action=\"approved\"}[24h])) / clamp_min(sum(increase(examlops_approval_events_total{action=~\"approved|rejected\"}[24h])), 1), 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.8}]}
        }
      }
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Oldest Pending SLA Risk",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "examlops_approval_age_oldest_seconds / 86400", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0, "max": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Approval Queue Depth Over Time",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "examlops_approvals_pending",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "examlops_approval_age_oldest_seconds / 3600",
          "legendFormat": "oldest_age_h",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "oldest_age_h"}, "properties": [{"id": "unit", "value": "h"}]},
          {"matcher": {"id": "byName", "options": "pending"}, "properties": [{"id": "unit", "value": "short"}]}
        ]
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Event Rates",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Approval Events Rate by Model & Action",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(examlops_approval_events_total{action=\"created\"}[5m])",  "legendFormat": "created  {{model_id}}", "refId": "A"},
        {"expr": "rate(examlops_approval_events_total{action=\"approved\"}[5m])", "legendFormat": "approved {{model_id}}", "refId": "B"},
        {"expr": "rate(examlops_approval_events_total{action=\"rejected\"}[5m])", "legendFormat": "rejected {{model_id}}", "refId": "C"}
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 8},
          "unit": "reqps"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Auto-Expiry Rate & Oldest Approval Age",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "increase(examlops_approvals_expired_total[1h]) or vector(0)",
          "legendFormat": "expired/h",
          "refId": "A"
        },
        {
          "expr": "examlops_approval_age_oldest_seconds / 3600",
          "legendFormat": "oldest pending (h)",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "oldest pending (h)"}, "properties": [{"id": "unit", "value": "h"}]},
          {"matcher": {"id": "byName", "options": "expired/h"}, "properties": [{"id": "unit", "value": "short"}]}
        ]
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Approval Event Log",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 21},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "logs",
      "title": "Approval Gate Events",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 22},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{project=\"examlops\",compose_service=\"control-plane\"} |~ \"(?i)(approved|rejected|expired|pending approval|notify_changes)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["examlops", "approvals", "mlops"],
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "ExaMLOps — Approval Gate",
  "uid": "examlops-approvals",
  "version": 2
}
