{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "ExaMLOps — online inference metrics: request rate, latency percentiles, error rates, SLO tracking, prediction drift",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Overview",      "url": "/d/examlops-overview",      "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""},
    {"title": "Drift Monitor", "url": "/d/examlops-drift",         "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""},
    {"title": "SeanerBUS",     "url": "/d/examlops-seanerbus",     "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""}
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Models Loaded",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(ray_examlops_models_loaded)", "legendFormat": "models", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(ray_examlops_predict_requests_total[1m]))", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps", "decimals": 2}
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[5m])) / sum(rate(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "percentunit", "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latency p50",
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.50, sum by(le) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 0.5}]}
        }
      }
    },
    {
      "id": 40,
      "type": "stat",
      "title": "Latency p95",
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by(le) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.8}]}
        }
      }
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Latency p99",
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by(le) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1.0}]}
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hot Reloads (total)",
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(ray_examlops_reload_total{status=\"success\"}) or vector(0)", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "decimals": 0}}
    },
    {
      "id": 200,
      "type": "row",
      "title": "SLO — 99.5% Availability Target",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "type": "gauge",
      "title": "SLO Compliance (30 d)",
      "gridPos": {"h": 5, "w": 5, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "1 - sum(increase(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[30d])) / clamp_min(sum(increase(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[30d])), 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.95, "max": 1.0,
          "decimals": 4,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.995}]}
        }
      }
    },
    {
      "id": 52,
      "type": "gauge",
      "title": "Error Budget Remaining (30 d, 0.5% budget)",
      "gridPos": {"h": 5, "w": 5, "x": 5, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "1 - clamp_min(sum(increase(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[30d])) / (0.005 * clamp_min(sum(increase(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[30d])), 1)), 0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "showThresholdLabels": true, "showThresholdMarkers": true},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "decimals": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "green", "value": 0.5}]}
        }
      }
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "SLO Burn Rate (1 h vs 6 h vs 24 h)",
      "description": "Burn rate > 1 means error budget is being consumed faster than the target rate. Burn rate > 14.4 (1h) triggers a page.",
      "gridPos": {"h": 5, "w": 14, "x": 10, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[1h])) / clamp_min(sum(rate(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[1h])), 0.001) / 0.005",
          "legendFormat": "burn_rate_1h",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[6h])) / clamp_min(sum(rate(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[6h])), 0.001) / 0.005",
          "legendFormat": "burn_rate_6h",
          "refId": "B"
        },
        {
          "expr": "sum(rate(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[24h])) / clamp_min(sum(rate(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[24h])), 0.001) / 0.005",
          "legendFormat": "burn_rate_24h",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 8},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 14.4}]}
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Traffic",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 11},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Rate by Model (served vs failed vs refused)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by(model_name) (rate(ray_examlops_predict_requests_total{status=\"success\"}[1m]))", "legendFormat": "{{model_name}} ✓", "refId": "A"},
        {"expr": "sum by(model_name) (rate(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[1m]))",   "legendFormat": "{{model_name}} ✗", "refId": "B"},
        {"expr": "sum by(model_name) (rate(ray_examlops_predict_requests_total{status=~\"invalid|not_found\"}[1m]))",   "legendFormat": "{{model_name}} refused (client)", "refId": "C"}
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "spanNulls": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"dash": [4, 4], "fill": "dash"}},
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error Rate by Model (%)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by(model_name) (rate(ray_examlops_predict_requests_total{status=~\"error|timeout|deadline_exceeded\"}[5m])) / sum by(model_name) (rate(ray_examlops_predict_requests_total{status=~\"success|error|timeout|deadline_exceeded\"}[5m])) * 100",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0,
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Latency Percentiles — All Models Combined",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by(le) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by(le) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by(le) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5}
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "p95 Latency by Model",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, model_name) (rate(ray_examlops_predict_latency_seconds_bucket[1m])))",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10}
        }
      }
    },
    {
      "id": 60,
      "type": "table",
      "title": "Per-Model Latency Summary (last 5 min)",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 29},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le, model_name) (rate(ray_examlops_predict_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model_name}}",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le, model_name) (rate(ray_examlops_predict_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model_name}}",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le, model_name) (rate(ray_examlops_predict_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{model_name}}",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "sum by(model_name) (rate(ray_examlops_predict_requests_total[5m]))",
          "legendFormat": "req/s {{model_name}}",
          "refId": "D",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "req/s", "desc": true}]
      },
      "fieldConfig": {
        "defaults": {"unit": "s", "decimals": 4},
        "overrides": [
          {"matcher": {"id": "byNamePattern", "options": "req/s.*"}, "properties": [{"id": "unit", "value": "reqps"}, {"id": "decimals", "value": 3}]}
        ]
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Prediction Values (Drift Proxy)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 35},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Prediction Value Median by Model",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le, model_name) (rate(ray_examlops_prediction_value_bucket[5m])))",
          "legendFormat": "{{model_name}} p50",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "stdDev", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10}
        }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Prediction Value p05 / p95 Spread",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, model_name) (rate(ray_examlops_prediction_value_bucket[5m])))",
          "legendFormat": "{{model_name}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.05, sum by(le, model_name) (rate(ray_examlops_prediction_value_bucket[5m])))",
          "legendFormat": "{{model_name}} p05",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5}
        }
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Model Reload Activity",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 44},
      "collapsed": true,
      "panels": [
        {
          "id": 45,
          "type": "timeseries",
          "title": "Model Reload Events (success / error)",
          "gridPos": {"h": 7, "w": 24, "x": 0, "y": 45},
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "targets": [
            {"expr": "rate(ray_examlops_reload_total{status=\"success\"}[5m])", "legendFormat": "reload_ok {{model_name}}", "refId": "A"},
            {"expr": "rate(ray_examlops_reload_total{status!=\"success\"}[5m])", "legendFormat": "reload_err {{model_name}}", "refId": "B"}
          ],
          "options": {
            "tooltip": {"mode": "multi"},
            "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"]}
          },
          "fieldConfig": {
            "defaults": {
              "color": {"mode": "palette-classic"},
              "custom": {"lineWidth": 1, "fillOpacity": 10},
              "unit": "reqps"
            }
          }
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["examlops", "mlops", "inference", "slo"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "ExaMLOps — Online Inference Metrics",
  "uid": "examlops-online-metrics",
  "version": 2
}
