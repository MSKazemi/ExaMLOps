{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "annotations": {
    "list": [
      {
        "datasource": {"type": "loki", "uid": "loki"},
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Bridge Errors",
        "target": {
          "expr": "{project=\"examlops\",compose_service=\"seanerbus-bridge\"} |~ \"(?i)(error|exception|fail)\"",
          "maxLines": 50,
          "refId": "bridge-err"
        },
        "type": "logs"
      }
    ]
  },
  "description": "SeanerBUS Bridge — per-model inference rate, error rate, latency percentiles, retrain triggers, and bridge health",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Overview",          "url": "/d/examlops-overview",      "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""},
    {"title": "Inference Metrics", "url": "/d/examlops-online-metrics", "type": "link", "targetBlank": false, "icon": "external link", "tags": [], "tooltip": ""}
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Bridge Health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bridge Status",
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "seanerbus_bridge_up", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Offline", "color": "red",   "index": 0}}},
            {"type": "value", "options": {"1": {"text": "Online",  "color": "green", "index": 1}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Inferences (24 h)",
      "gridPos": {"h": 3, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(seanerbus_inferences_total[24h])", "legendFormat": "{{model_id}}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5 min)",
      "gridPos": {"h": 3, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(seanerbus_inference_errors_total[5m])) / sum(rate(seanerbus_inferences_total[5m])) * 100",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latency p50 (5 min)",
      "gridPos": {"h": 3, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.50, sum by(le) (rate(seanerbus_inference_latency_seconds_bucket[5m])))", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.3}]}
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latency p99 (5 min)",
      "gridPos": {"h": 3, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.99, sum by(le) (rate(seanerbus_inference_latency_seconds_bucket[5m])))", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.5}]}
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Retrain Triggers (24 h)",
      "gridPos": {"h": 3, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(seanerbus_retrain_triggers_total[24h]) or vector(0)", "legendFormat": "", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "auto"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Inference Rate by Model (req/s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(seanerbus_inferences_total[2m])", "legendFormat": "{{model_id}}", "refId": "A"}
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "reqps"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error Rate by Model (%)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(seanerbus_inference_errors_total[2m]) / rate(seanerbus_inferences_total[2m]) * 100",
          "legendFormat": "{{model_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "percent", "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Inference Latency p50 / p95 / p99 (all models)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by(le) (rate(seanerbus_inference_latency_seconds_bucket[2m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by(le) (rate(seanerbus_inference_latency_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by(le) (rate(seanerbus_inference_latency_seconds_bucket[2m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 5},
          "unit": "s"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Latency p99 by Model",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(le, model_id) (rate(seanerbus_inference_latency_seconds_bucket[2m])))",
          "legendFormat": "{{model_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 5},
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.5}]}
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Retrain Triggers",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Retrain Trigger Rate",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(seanerbus_retrain_triggers_total[5m]) or vector(0)",
          "legendFormat": "retrain triggers/s",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "unit": "reqps"
        }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Bridge Logs",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30},
      "collapsed": true,
      "panels": [
        {
          "id": 41,
          "type": "logs",
          "title": "SeanerBUS Bridge Logs",
          "gridPos": {"h": 10, "w": 24, "x": 0, "y": 31},
          "datasource": {"type": "loki", "uid": "loki"},
          "targets": [
            {
              "expr": "{project=\"examlops\",compose_service=\"seanerbus-bridge\"}",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "options": {
            "dedupStrategy": "none",
            "enableLogDetails": true,
            "prettifyLogMessage": true,
            "showLabels": false,
            "showTime": true,
            "sortOrder": "Descending",
            "wrapLogMessage": false
          }
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["examlops", "seanerbus", "inference"],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "title": "SeanerBUS Bridge",
  "uid": "examlops-seanerbus",
  "version": 2
}
