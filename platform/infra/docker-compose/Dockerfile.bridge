FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libcapnp-dev capnproto \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir pycapnp httpx prometheus_client pyyaml

# Directory names vary by deploy environment:
#   local dev:  SEANERBUS_DIR=seanerbus          AI_PRODUCTIONS_DIR=ai-productions
#   lxp-cpu01:  SEANERBUS_DIR=examlops-seanerbus/seanerbus  AI_PRODUCTIONS_DIR=examlops
ARG SEANERBUS_DIR=seanerbus
ARG AI_PRODUCTIONS_DIR=ai-productions

# Copy and install the seanerbus Python bindings
# (build context is the parent seanergys/ directory so both repos are accessible)
COPY ${SEANERBUS_DIR}/bindings/python /app/seanerbus-pkg
RUN pip install --no-cache-dir /app/seanerbus-pkg

# Install the examlops platform library — WITHOUT it, the bridge's
# `from examlops.platform_db import …` fails at startup, _PLATFORM_DB_AVAILABLE flips False,
# and every per-inference drift/input/audit write becomes a silent no-op: the entire
# Phase 19/20/21 telemetry loop sees zero data from the bus path in Docker.
COPY ${AI_PRODUCTIONS_DIR}/platform/cli /app/examlops-cli
RUN pip install --no-cache-dir /app/examlops-cli

# Copy bridge client code from ai-productions
COPY ${AI_PRODUCTIONS_DIR}/platform/clients/ /app/clients/
COPY ${AI_PRODUCTIONS_DIR}/usecases/seanergy/models /app/usecases/seanergy/models

WORKDIR /app

CMD ["python", "clients/seanerbus_bridge.py"]
