FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libcapnp-dev capnproto \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir pycapnp httpx prometheus_client pyyaml

# Directory names vary by deploy environment:
#   local dev:  DATAPLANE_BUS_DIR=dataplane-bus          AI_PRODUCTIONS_DIR=ai-productions
#   lxp-cpu01:  DATAPLANE_BUS_DIR=examlops-dataplane-bus/dataplane-bus  AI_PRODUCTIONS_DIR=examlops
ARG DATAPLANE_BUS_DIR=dataplane-bus
ARG AI_PRODUCTIONS_DIR=ai-productions

# Copy and install the dataplane-bus Python bindings
# (build context is the parent directory so both repos are accessible)
COPY ${DATAPLANE_BUS_DIR}/bindings/python /app/dataplane-bus-pkg
RUN pip install --no-cache-dir /app/dataplane-bus-pkg

# Install the examlops platform library — WITHOUT it, the bridge's
# `from examlops.platform_db import …` fails at startup, _PLATFORM_DB_AVAILABLE flips False,
# and every per-inference drift/input/audit write becomes a silent no-op: the entire
# Phase 19/20/21 telemetry loop sees zero data from the bus path in Docker.
COPY ${AI_PRODUCTIONS_DIR}/platform/cli /app/examlops-cli
RUN pip install --no-cache-dir /app/examlops-cli

# Copy bridge client code from ai-productions
COPY ${AI_PRODUCTIONS_DIR}/platform/clients/ /app/clients/
COPY ${AI_PRODUCTIONS_DIR}/usecases/reference/models /app/usecases/reference/models

WORKDIR /app

CMD ["python", "clients/dataplane_bus_bridge.py"]
