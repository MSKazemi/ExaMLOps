# Optional ExaMLOps compatibility profile for the third-party kube-q (`kq`) client.
# Install:  cp this file to ~/.kube-q/profiles/examlops.env
# Launch:   KUBE_Q_PROFILE=examlops kq        (or: kq --profile examlops)
#
# Prefer `exa chat` for the native ExaMLOps workflow. This profile points kq's
# default backend at Skipper's limited OpenAI-compatible bridge (port 18004).
# Set KUBE_Q_API_KEY here only if the server is started with AGENT_API_KEY.

KUBE_Q_URL=http://localhost:18004
KUBE_Q_BACKEND=kube-q
KUBE_Q_MODEL=examlops-agent
# KUBE_Q_API_KEY=change-me-if-AGENT_API_KEY-is-set
