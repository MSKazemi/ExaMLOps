# ────────────────────────────────────────────────────────────────────────────
# ExaMLOps environment template — copy to .env and fill in.
# .env is gitignored. Never commit real secrets.
#
# Quick-start for a new server:
#   cp .env.example .env
#   # Set PUBLIC_HOST, passwords, JWT/Fernet keys, GITLAB_TOKEN
#   # Then: make stack-up
# ────────────────────────────────────────────────────────────────────────────

# ── Public host / IP ─────────────────────────────────────────────────────────
# IP or hostname that browsers use to reach this server (for CORS, redirects).
# Leave unset for localhost-only dev use.
# PUBLIC_HOST=your.server.ip.or.hostname

# ── Remote deploy node (site-specific — keep the real values in .env only) ───
# The committed tree carries generic defaults so no site's addressing is
# published. Set these on the deploy node, and locally if you use `make
# remote-rebuild`.
#
# EXAMLOPS_DEPLOY_HOST     ssh host/alias of the deploy node   (default: examlops-deploy)
# EXAMLOPS_DEPLOY_PATH     checkout path on that node          (default: /opt/examlops)
# EXAMLOPS_HOST_REPO       same path, seen from the Docker host; used for bind
#                          mounts and the JupyterHub spawner   (default: /opt/examlops)
# EXAMLOPS_GITLAB_HOST_ENTRY  "<gitlab-host>:<ip>" DNS pin injected into the
#                          control plane via docker-compose.lxp.yml extra_hosts,
#                          for nodes that cannot resolve an internal GitLab.
#
# EXAMLOPS_DEPLOY_HOST=my-deploy-node
# EXAMLOPS_DEPLOY_PATH=/srv/examlops
# EXAMLOPS_HOST_REPO=/srv/examlops
# EXAMLOPS_GITLAB_HOST_ENTRY=gitlab.internal.example.com:10.0.0.5

# Dashboard auth (REQUIRED — backend fails fast if any are unset)
# Two shared passwords. Anyone with the viewer password can read; anyone with
# the admin password can edit URLs and credentials. There is no user table.
#
# Generate both — do NOT paste a value from this file. Any password containing a
# placeholder marker (change-me / changeme / placeholder / your-token …) is refused
# by the login check, so that role cannot be logged into and startup logs an error:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_VIEWER_PASSWORD=
DASHBOARD_ADMIN_PASSWORD=

# JWT signing key — at least 32 random bytes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_JWT_SECRET=

# JWT lifetime (hours). Default 12.
DASHBOARD_JWT_TTL_HOURS=12

# Fernet key for at-rest encryption of stored credentials. 44-char base64
# urlsafe. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSE THIS KEY → STORED SECRETS ARE UNRECOVERABLE.
DASHBOARD_SECRET_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Slurm adapter (optional — defaults to mock mode)
# ────────────────────────────────────────────────────────────────────────────
EXAMLOPS_SLURM_MODE=mock
# Real scheduler (requires sbatch on the submitting host):
# EXAMLOPS_SLURM_MODE=slurm
# EXAMLOPS_SLURM_PARTITION=
# EXAMLOPS_SLURM_TIME=2:00:00
# EXAMLOPS_SLURM_NODES=1
# EXAMLOPS_SLURM_MEM=16G
# EXAMLOPS_SLURM_CPUS=4

# ────────────────────────────────────────────────────────────────────────────
# Ray Serve (optional — sensible defaults)
# ────────────────────────────────────────────────────────────────────────────
# RAY_NUM_REPLICAS=2
# RAY_SERVE_PORT=8001
# MODEL_STAGE=Production
# RAY_MODELS_DIR=pipelines/models          # Phase 14: per-model YAML directory (takes precedence over RAY_REGISTRY_PATH)

# ────────────────────────────────────────────────────────────────────────────
# MLflow / MinIO (optional — defaults match the compose stack)
# ────────────────────────────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:15000
# MLFLOW_S3_ENDPOINT_URL=http://localhost:19000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ────────────────────────────────────────────────────────────────────────────
# Management Agent (optional)
# ────────────────────────────────────────────────────────────────────────────
# Where Ollama is listening. Two common shapes:
#   local `ollama serve`            → http://localhost:11434
#   a GPU box reached over an SSH tunnel → whatever local port you forward to
# The value below is the second shape; change it to 11434 for a local daemon.
AGENT_OLLAMA_URL=http://localhost:11436
AGENT_MODEL=llama3.1:8b
# Larger models need a host that can hold them; pick from `ollama list`.
# AGENT_MODEL=hermes3:70b     # best tool calling
# AGENT_MODEL=llama3.1:70b    # best Llama quality
#
# Backend preference order: Azure OpenAI/Foundry → Claude API → Ollama.
# Set the two AZURE_OPENAI_* values below to route the agent at Azure Foundry.
#
# Azure AI Foundry (recommended balance: gpt-5.4-mini). The endpoint is the
# Foundry "v1" project endpoint base URL (note the trailing /openai/v1/), copied
# from the deployment page; the deployment name is the model id.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
# AZURE_OPENAI_API_KEY=<paste the API Key from the deployment page>
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
#
# Claude API (used only if the AZURE_OPENAI_* pair is unset):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# ────────────────────────────────────────────────────────────────────────────
# Phase 11 — ModelZoo integration (optional — sensible defaults)
# ────────────────────────────────────────────────────────────────────────────
# MODELZOO_WEBHOOK_SECRET=
# MODELZOO_AUTO_RETRAIN=false
# MODELZOO_POLL_SECONDS=300
# MODELZOO_WATCH_BRANCH=main
# GITLAB_URL=            # Your GitLab instance. Unset → https://gitlab.com
# GITLAB_PROJECT_ID=     # Numeric project id, from the project's Settings → General
# GITLAB_TOKEN=           # Personal access token (read_api scope)
#   Generate: GitLab → User Settings → Access Tokens → read_api, read_repository

# ────────────────────────────────────────────────────────────────────────────
# Control Plane (optional)
# ────────────────────────────────────────────────────────────────────────────
# Bearer token required for POST /retrain. Unset → 503 on all retrain calls.
# CONTROL_PLANE_TOKEN=
#   Generate one — do NOT paste a value from this file. Any token containing a placeholder
#   marker (changeme / change-me / placeholder / your-token …) is refused and every write
#   endpoint stays 503:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

# ────────────────────────────────────────────────────────────────────────────
# SeanerBUS bridge — where the bridge CONTAINER finds the SeanerBUS server
# ────────────────────────────────────────────────────────────────────────────
# THIS file is the one production uses: `make stack-up` runs docker compose with
# `--env-file <root>/.env`, and the bridge's `environment:` block interpolates
# ${SEANERBUS_HOST} from here (it overrides the compose-dir env_file). So set the
# effective value HERE, not in platform/infra/docker-compose/.env.
#
# The bridge runs in a container, so `localhost` = the container, NOT the host.
# Choose ONE based on where SeanerBUS runs:
#
#   • SeanerBUS is a CONTAINER on seanerbus-net  → use its container name (default):
#         SEANERBUS_HOST=seanerbus-reqgen
#
#   • SeanerBUS runs BARE-METAL on the host      → reach the host from the container:
#         SEANERBUS_HOST=host.docker.internal     # stable; needs extra_hosts (already in compose)
#       or the Docker bridge gateway IP (no compose change; can shift on stack-wipe):
#         SEANERBUS_HOST=<gateway-ip>             # print it: `docker network inspect examlops_default -f '{{(index .IPAM.Config 0).Gateway}}'`
#       Bare-metal SeanerBUS MUST bind 0.0.0.0:5398 (not 127.0.0.1) to be reachable.
#
# Verify the resolved value:
#   docker compose --env-file $(pwd)/.env --profile seanerbus config | grep SEANERBUS_HOST
# Background and the simulator: docs/guides/seanerbus-sim.md
SEANERBUS_HOST=seanerbus-reqgen
# SEANERBUS_PORT=5398
