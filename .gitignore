# Maintained directly in the public repo — NOT regenerated by publish.sh.
# Keep this conservative: nothing internal should ever be committable here.

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local env / secrets (defense in depth — these should never be generated here)
.env
.env.*
*.key
*.pem

# Editor / OS
.vscode/
.idea/
.DS_Store

# Data / DB artifacts
*.db
*.log
.data_cache/
