# ═══════════════════════════════════════════════════════════════════════════
# Shared by BOTH gits (dualgit layer 2): .git (public) and .git-private.
#
# This file carries NO public/private split — that is the firewall's job
# (.git/info/exclude, generated from .dualgit/). Here we list only universal
# junk: secrets, build output, caches, editor and OS noise.
#
# NOTE: an ignore rule never untracks an already-tracked file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets ────────────────────────────────────────────────────────────────
.env
.env.*
*.local
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# ── Python ─────────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
pycache/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover

# uv workspace lockfile — deps not yet consolidated into the workspace.
# (Already tracked in the public git; this only stops NEW ones appearing.)
uv.lock

# ── Node / JS / TS ─────────────────────────────────────────────────────────
node_modules/
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Go ─────────────────────────────────────────────────────────────────────
*.exe
*.test
*.out
vendor/

# ── Rust ───────────────────────────────────────────────────────────────────
target/
Cargo.lock.bak

# ── Editors / IDEs ─────────────────────────────────────────────────────────
.vscode/
.idea/
.run/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── ExaMLOps runtime data ──────────────────────────────────────────────────
platform.db
agent_memory.db
skipper_memory.db
approvals.db
mlflow.db
*.db
.data_cache/
slurm_jobs/
flux_jobs/
# Authored calculation providers — runtime data (ADR 0074)
.providers/

# ── Logs / temp / test artefacts ───────────────────────────────────────────
*.log
*.tmp
.cache/
temp/
.playwright/
.playwright-mcp/
/playwright-report/
/screenshots/
/*.png
/*.jpg
/*.jpeg

# ── Ephemeral design-session output (never belongs in git) ─────────────────
# docs/ is the public user-doc tier; design/ is the private dev-doc tier.
# Brainstorming/plan scratch output must live in neither.
docs/superpowers/
design/superpowers/

# ── APEX reference library — third-party PDFs, reconstructable from
#    design/vision/library/papers/manifest-*.tsv
design/vision/library/papers/*.pdf
design/vision/library/papers/FAILED.tsv

# ── Legacy p2p / reposync local state (superseded by dual-git) ─────────────
.p2p.toml
.p2p-manifest.json
.p2p-history.jsonl
.p2p-baseline.json
.p2p-undo/

# ── Docs build output ──────────────────────────────────────────────────────
site/
_site/
.docusaurus/

# ── Terraform / IaC ────────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ── Kubernetes / Helm ──────────────────────────────────────────────────────
values-prod.yaml
values-production.yaml
values-vm.yaml
values-aks.yaml
values-eks.yaml
values-gke.yaml
charts/*/charts/
